local rotationBox = addInput(tabRotation, "Model Angle Offsets (X, Y, Z Degrees)", "0, 0, 0")

local function parseRotation()
	local angles = {}
	for num in string.gmatch(rotationBox.Text, "[%-%d%.]+") do
		table.insert(angles, tonumber(num))
	end
	if #angles >= 3 then
		return CFrame.Angles(math.rad(angles[1]), math.rad(angles[2]), math.rad(angles[3]))
	end
	return CFrame.Angles(0, 0, 0)
end

