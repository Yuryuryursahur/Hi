-- UTILITIES
local function parseBlacklist()
	local list = {}
	for name in string.gmatch(blacklistText.Text, "[^,]+") do
		local cleanName = string.lower(string.match(name, "^%s*(.-)%s*$"))
		if cleanName ~= "" then
			table.insert(list, cleanName)
		end
	end
	return list
end

local function parseOffset()
	local coords = {}
	for num in string.gmatch(offsetBox.Text, "[%-%d%.]+") do
		table.insert(coords, tonumber(num))
	end
	if #coords >= 3 then
		return Vector3.new(coords[1], coords[2], coords[3])
	end
	return Vector3.new(500, 500, 0)
end

-- CORE HELPER TO SPAWN AND CONFIGURE A BLOCK
local function spawnBlock(template, cframe, brickColor, material, size, imageId, soundId, playbackSpeed, isLight, lightColor, lightRange, lightBrightness, customColor, buildModel, baseSpawnCFrame, gridIndex)
	local gridX = ((gridIndex - 1) % 15) * 6
	local gridZ = math.floor((gridIndex - 1) / 15) * 6
	local clearanceCFrame = baseSpawnCFrame * CFrame.new(gridX, 0, gridZ)

	local spawnedInstance = nil
	local connection = buildModel.ChildAdded:Connect(function(child)
		spawnedInstance = child
	end)

	pcall(function()
		PlaceBlockRemote:InvokeServer(
			template,
			clearanceCFrame,
			brickColor,
			material
		)
	end)

	local t = 0
	while not spawnedInstance and t < 0.25 do
		task.wait(0.005)
		t = t + 0.005
	end

	if connection then connection:Disconnect() end
	local newBlock = spawnedInstance or (buildModel:GetChildren())[#buildModel:GetChildren()]

	if newBlock then
		pcall(function()
			CommitMoveRemote:InvokeServer(newBlock, cframe)
		end)

		local colorPart = newBlock:FindFirstChild("ColorPart") or newBlock
		pcall(function()
			CommitResizeRemote:InvokeServer(newBlock, {
				colorPart,
				cframe,
				size
			})
		end)

		if UpdateBlockSettingsRemote then
			local settingsDict = {}

			if isLight then
				settingsDict["R"] = math.clamp(math.floor(lightColor.R * 255), 0, 255)
				settingsDict["G"] = math.clamp(math.floor(lightColor.G * 255), 0, 255)
				settingsDict["B"] = math.clamp(math.floor(lightColor.B * 255), 0, 255)
				settingsDict["Range"] = math.clamp(math.floor(lightRange), 1, 60)
				settingsDict["Brightness"] = math.clamp(math.floor(lightBrightness), 1, 30)
			end

			if imageId then
				settingsDict["Image Id"] = imageId
			end

			if soundId then
				settingsDict["Sound Id"] = soundId
				settingsDict["PlaybackSpeed"] = playbackSpeed
			end

			if next(settingsDict) ~= nil then
				pcall(function()
					UpdateBlockSettingsRemote:InvokeServer(newBlock, settingsDict)
				end)
			end
		end

		if colorPart and colorPart:IsA("BasePart") and customColor then
			pcall(function() colorPart.Color = customColor end)
		end
	end

	return newBlock
end

-- PLACE BLOCK PROCESSOR (DUAL-LAYER SYSTEM)
local function placeSingleBlock(index, data, offsetVector, baseSpawnCFrame, buildModel)
	local finalCF = CFrame.new(data.cframe.Position + offsetVector) * currentRotationCF * (data.cframe - data.cframe.Position)

	-- STEP 1: PLACE BASE SHADOW BLOCK
	spawnBlock(
		data.template,
		finalCF,
		data.brickColor,
		data.material,
		data.size,
		nil,
		data.soundId,
		data.playbackSpeed,
		false,
		nil, nil, nil,
		data.color,
		buildModel,
		baseSpawnCFrame,
		index
	)

	-- STEP 2: PLACE OVERLAY TEXTURE BLOCK (Slightly oversized by 0.05 studs, NO color/RGB tint passed)
	if data.imageId and TextureBlockTemplate then
		task.wait(0.02)
		local slightlyLargerSize = data.size + Vector3.new(0.05, 0.05, 0.05)
		spawnBlock(
			TextureBlockTemplate,
			finalCF,
			BrickColor.new("Institutional white"),
			Enum.Material.SmoothPlastic,
			slightlyLargerSize,
			data.imageId,
			nil,
			1,
			false,
			nil, nil, nil,
			nil, -- Color explicitly omitted to prevent texture updating issues
			buildModel,
			baseSpawnCFrame,
			index + 50000
		)
	end

	-- STEP 3: PLACE INVISIBLE LIGHT OVERLAY (IF LIGHT SOURCE WAS DETECTED)
	if data.isLight and InvisibleLightTemplate then
		task.wait(0.02)
		spawnBlock(
			InvisibleLightTemplate,
			finalCF,
			BrickColor.new("White"),
			Enum.Material.Plastic,
			data.size,
			nil, nil, nil,
			true,
			data.lightColor,
			data.lightRange,
			data.lightBrightness,
			data.lightColor,
			buildModel,
			baseSpawnCFrame,
			index + 100000
		)
	end
end

-- WORKSPACE SCANNER
local function scanWorkspaceModel()
	local target = Workspace:FindFirstChild(modelNameBox.Text, true)
	if not target then return nil end

	local blacklist = parseBlacklist()
	local partsCatalog = {}
	local descendants = target:IsA("BasePart") and {target} or target:GetDescendants()

	for _, descendant in ipairs(descendants) do
		if descendant:IsA("BasePart") then
			local isBlacklisted = false
			local checkInstance = descendant

			while checkInstance and checkInstance ~= Workspace do
				local lowerName = string.lower(checkInstance.Name)
				for _, skipName in ipairs(blacklist) do
					if string.find(lowerName, skipName, 1, true) then
						isBlacklisted = true
						break
					end
				end
				if isBlacklisted then break end
				checkInstance = checkInstance.Parent
			end

			if not isBlacklisted then
				local imageId = nil
				local soundId = nil
				local playbackSpeed = 1
				local isLight = false
				local lightColor = Color3.fromRGB(255, 255, 255)
				local lightRange = 12
				local lightBrightness = 1

				-- SCAN FOR TEXTURE/DECAL ON PART OR DESCENDANTS
				local decal = descendant:FindFirstChildOfClass("Decal") or descendant:FindFirstChildOfClass("Texture")
				if not decal then
					decal = descendant:FindFirstChildWhichIsA("Decal", true) or descendant:FindFirstChildWhichIsA("Texture", true)
				end

				if decal and decal.Texture ~= "" then
					imageId = tonumber(string.match(decal.Texture, "%d+"))
				end

				local finalColor = descendant.Color

				-- SCAN FOR SOUND
				local sound = descendant:FindFirstChildOfClass("Sound") or descendant:FindFirstChildWhichIsA("Sound", true)
				if sound and sound.SoundId ~= "" then
					soundId = tonumber(string.match(sound.SoundId, "%d+"))
					playbackSpeed = sound.PlaybackSpeed or 1
				end

				-- AUTO SEARCH FOR LIGHTS (PARTS & ATTACHMENTS)
				local light = findLightInPartOrAttachments(descendant)
				if light then
					isLight = true
					lightColor = light.Color
					lightRange = light.Range
					lightBrightness = light.Brightness
				end

				table.insert(partsCatalog, {
					cframe = descendant.CFrame,
					size = descendant.Size,
					color = finalColor,
					brickColor = BrickColor.new(finalColor),
					material = descendant.Material,
					template = getTemplateForPart(descendant),
					imageId = imageId,
					soundId = soundId,
					playbackSpeed = playbackSpeed,
					isLight = isLight,
					lightColor = lightColor,
					lightRange = lightRange,
					lightBrightness = lightBrightness
				})
			end
		end
	end
	return partsCatalog
end

-- REPLICATION CONTROLLER
local function replicateTarget(resumeOnly)
	local catalog = scanWorkspaceModel()

	if not catalog or #catalog == 0 then
		statusLabel.Text = "[ERROR]: TARGET NOT FOUND OR EMPTY"
		return
	end

	local offsetVector = parseOffset()
	local buildModel = Workspace:FindFirstChild("BuildModel") or Workspace

	local existingPositions = {}
	if resumeOnly then
		statusLabel.Text = "[STATUS]: SCANNING EXISTING MAP..."
		for _, child in ipairs(buildModel:GetChildren()) do
			local part = child:FindFirstChild("ColorPart") or child
			if part and part:IsA("BasePart") then
				local pos = part.Position
				local key = math.floor(pos.X + 0.5) .. "_" .. math.floor(pos.Y + 0.5) .. "_" .. math.floor(pos.Z + 0.5)
				existingPositions[key] = true
			end
		end
	end

	local missingCatalog = {}
	for _, data in ipairs(catalog) do
		local targetCFrame = CFrame.new(data.cframe.Position + offsetVector) * currentRotationCF * (data.cframe - data.cframe.Position)
		local pos = targetCFrame.Position
		local key = math.floor(pos.X + 0.5) .. "_" .. math.floor(pos.Y + 0.5) .. "_" .. math.floor(pos.Z + 0.5)

		if not resumeOnly or not existingPositions[key] then
			table.insert(missingCatalog, data)
		end
	end

	if #missingCatalog == 0 then
		statusLabel.Text = "[STATUS]: ALL PARTS ALREADY PLACED"
		return
	end

	local baseSpawnCFrame = CFrame.new(0, 100, 0)
	if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
		baseSpawnCFrame = LocalPlayer.Character.HumanoidRootPart.CFrame * CFrame.new(0, 100, 0)
	end

	local total = #missingCatalog
	for index, data in ipairs(missingCatalog) do
		if not isRunning then break end
		statusLabel.Text = "[STATUS]: PLACING " .. index .. " / " .. total
		placeSingleBlock(index, data, offsetVector, baseSpawnCFrame, buildModel)
		task.wait(0.05)
	end

	if isRunning then statusLabel.Text = "[STATUS]: FINISHED REPLICATING" end
end

