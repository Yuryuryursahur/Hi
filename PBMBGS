				statusLabel.Text = "[STATUS]: LOADED " .. string.upper(nameStr)
			end)
		end
	end

	statusLabel.Text = "[STATUS]: PAGE " .. currentPage .. " | DISPLAYING " .. displayedCount .. " MODELS"
end

-- SEARCH ENGINE
local forwardSearchStore = nil

local function searchCreatorStore(query, page)
	if not httpRequest then
		statusLabel.Text = "[ERROR]: HTTP REQUEST NOT SUPPORTED ON EXECUTOR"
		return
	end

	currentPage = page or 1
	currentSearchQuery = query
	statusLabel.Text = "[STATUS]: SEARCHING MODELS (PAGE " .. currentPage .. ")..."

	task.spawn(function()
		local headers = {
			["User-Agent"] = "Roblox/WinInet",
			["Accept"] = "application/json"
		}

		local limit = 12
		local url = "https://catalog.roblox.com/v1/search/items/details?Category=6&Keyword=" 
			.. HttpService:UrlEncode(query) 
			.. "&Limit=" .. limit 

		local success, response = pcall(function()
			return httpRequest({ Url = url, Method = "GET", Headers = headers })
		end)

		if success and response and response.StatusCode == 200 then
			local decodeSuccess, decoded = pcall(function()
				return HttpService:JSONDecode(response.Body)
			end)

			if decodeSuccess and decoded and decoded.data and #decoded.data > 0 then
				populateResults(decoded.data)
				return
			end
		end

		statusLabel.Text = "[ERROR]: NO MODELS FOUND FOR '" .. query .. "'"
	end)
end

