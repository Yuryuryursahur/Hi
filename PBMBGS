	end

	if not itemList or #itemList == 0 then
		statusLabel.Text = "[STATUS]: NO MODELS FOUND"
		return
	end

	local displayedCount = 0
	for _, item in ipairs(itemList) do
		local id = item.id or item.Id or item.assetId or item.AssetId
		local name = item.name or item.Name or item.title or item.Title or ("Model " .. tostring(id))

		if id then
