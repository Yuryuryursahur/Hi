-- HELPER: LIGHT DETECTION
local function findLightInPartOrAttachments(part)
	local directLight = part:FindFirstChildOfClass("PointLight") or part:FindFirstChildOfClass("SurfaceLight") or part:FindFirstChildOfClass("SpotLight")
	if directLight then return directLight end

	for _, descendant in ipairs(part:GetDescendants()) do
		if descendant:IsA("Attachment") then
			local attachLight = descendant:FindFirstChildOfClass("PointLight") or descendant:FindFirstChildOfClass("SurfaceLight") or descendant:FindFirstChildOfClass("SpotLight")
			if attachLight then return attachLight end
		end
	end
	return nil
end

-- SHAPE TEMPLATE RESOLVER
local function getTemplateForPart(part)
	local name = string.lower(part.Name)
	local className = part.ClassName

	if part.Transparency > 0.05 or part.Material == Enum.Material.Glass then
		if string.find(name, "thin") or string.find(name, "wall") then
			if TransparentThinWallTemplate then return TransparentThinWallTemplate end
		end
		if string.find(name, "window") or string.find(name, "glass") then
			if WindowBlockTemplate then return WindowBlockTemplate end
		end
		if TransparentBlockTemplate then return TransparentBlockTemplate end
	end

	if string.find(name, "tshape") or string.find(name, "thinwallt") then
		if BasicBlocks:FindFirstChild("ThinWallTShape") then
			return BasicBlocks.ThinWallTShape:FindFirstChild("ThinWallTShape")
		end
	elseif string.find(name, "corner") or string.find(name, "thinwallcorner") then
		if BasicBlocks:FindFirstChild("ThinWallCorner") then
			return BasicBlocks.ThinWallCorner:FindFirstChild("ThinWallCorner")
		end
	elseif className == "WedgePart" or string.find(name, "wedge") then
		if BasicBlocks:FindFirstChild("Wedge") then
			return BasicBlocks.Wedge:FindFirstChild("Wedge")
		end
	elseif className == "CylinderPart" or string.find(name, "cylinder") then
		if BasicBlocks:FindFirstChild("Cylinder") then
			return BasicBlocks.Cylinder:FindFirstChild("Cylinder")
		end
	elseif className == "Part" and part.Shape == Enum.PartType.Ball or string.find(name, "sphere") then
		if BasicBlocks:FindFirstChild("Sphere ") then
			return BasicBlocks["Sphere "]:FindFirstChild("Sphere ")
		end
	elseif string.find(name, "tooth") then
		if BasicBlocks:FindFirstChild("ToothBlock") then
			return BasicBlocks.ToothBlock:FindFirstChild("ToothBlock")
		end
	end

	return DefaultBlockTemplate
end

